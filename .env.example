# ==========================================================
# KKBOX Open API 設定
# 請至 KKBOX 開發者平台申請帳號並建立應用程式：
# https://developer.kkbox.com/
# ==========================================================
KKBOX_CLIENT_ID=your_kkbox_client_id_here
KKBOX_CLIENT_SECRET=your_kkbox_client_secret_here

# ==========================================================
# MySQL 資料庫連線設定
# ==========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=Fjbc
DB_CHARSET=utf8mb4
